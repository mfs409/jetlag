{
    "name": "jetlag2d",
    "version": "2.0.0",
    "description": "A 2D Game Framework for web and mobile, using PIXI.js and Box2D",
    "scripts": {
        "start": "node cli/main.mjs serve",
        "create": "node cli/main.mjs create",
        "serve": "node cli/main.mjs serve",
        "build": "node cli/main.mjs build",
        "zip": "node cli/main.mjs zip",
        "check": "tsc --noEmit",
        "clean": "node cli/main.mjs clean",
        "help": "node cli/main.mjs help"
    },
    "owner": "Michael Spear",
    "license": "MIT",
    "type": "module",
    "dependencies": {
        "@box2d/core": "^0.11.0",
        "@types/hammerjs": "^2.0.46",
        "@types/howler": "^2.2.13",
        "adm-zip": "^0.6.1",
        "chalk": "^6.0.0",
        "esbuild": "^0.28.1",
        "hammerjs": "^2.0.8",
        "howler": "^2.2.4",
        "pixi-filters": "^6.1.5",
        "pixi.js": "^8.19.0",
        "socket.io-client": "^4.8.3"
    },
    "devDependencies": {
        "typescript": "^7.0.2"
    },
    "bin": {
        "jetlag2d": "cli/main.mjs"
    },
    "main": "src/jetlag.ts",
    "types": "src/jetlag.ts",
    "exports": {
        ".": "./src/jetlag.ts",
        "./cli": "./cli/main.mjs",
        "./package.json": "./package.json"
    },
    "files": [
        "src/jetlag.ts",
        "src/jetlag",
        "cli",
        "templates",
        "!templates/**/node_modules",
        "!templates/**/dist"
    ]
}
